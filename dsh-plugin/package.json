{
  "name": "dsh-plugin-bubble-ask",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "description": "划词提问：把精简会话轨迹作为上下文注入网页版（默认 DeepSeek，可选千问/豆包/ChatGPT/Gemini/Grok），解释选中文字在当前会话中的含义",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/ask-client.mjs",
    "lib/providers.data.js",
    "lib/driver.source.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
